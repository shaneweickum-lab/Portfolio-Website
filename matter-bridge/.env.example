# Copy to .env and fill in. Never commit the real .env.

# Local port the Fastify HTTP API listens on.
PORT=8787

# Only origin allowed to call this bridge (CORS). Your deployed site's exact origin.
ALLOWED_ORIGIN=https://shaneweickum.dev

# Filled in automatically by `npm run commission` after a successful pairing —
# the matter.js node id assigned to your plug. Do not set this by hand.
PLUG_NODE_ID=

# How long the plug stays on after a visitor toggles it on, in milliseconds,
# before the bridge automatically turns it back off. Default: 15s.
AUTO_OFF_MS=15000
